# Cloudflare Pages response headers.
# __API_ORIGIN__ is replaced at build time with the origin of VITE_API_BASE_URL (vite.config.ts),
# so the page may talk to exactly one API host.
#
# Content-Security-Policy, by directive:
#   script-src   our bundle and theme-init.js, plus Bluesky's official embed script (loaded on click)
#   style-src    'unsafe-inline' because Leaflet and the embeds set style attributes; scripts stay locked
#   img-src      raster map tiles (OpenStreetMap, the fallback), YouTube API thumbnails and the cleared
#                illustrative photos from Wikimedia Commons (thumb./upload.wikimedia.org)
#   connect-src  the API, and OpenFreeMap's vector map style, tiles, fonts and sprites
#   worker-src   MapLibre's map worker, served from our own origin
#   frame-src    the two official embeds, loaded only when the reader asks
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://embed.bsky.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://tiles.openfreemap.org https://i.ytimg.com https://thumb.wikimedia.org https://upload.wikimedia.org; font-src 'self'; connect-src 'self' __API_ORIGIN__ https://tiles.openfreemap.org; worker-src 'self'; frame-src https://embed.bsky.app https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
